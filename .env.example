# .env.example — commit this; .env — NEVER commit.
# Both values are public by design (browser bundle). Never put a secret in a VITE_ variable.

# Supabase project qixpdeqjrkvfurqhzvtc
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side secrets are NOT set here. They live in Supabase
# (supabase secrets set ...): GEMINI_API_KEY_1, RESEND_API_KEY, EMAIL_FROM,
# RESEND_WEBHOOK_SECRET (optional).
